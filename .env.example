# Copy to .env.local and fill in. Never commit .env.local.
# Only placeholders belong in this file.

# Canonical origin. Metadata, sitemap, llms.txt and the email logo URL use it.
# Defaults to https://www.acertainwoman.org when unset.
NEXT_PUBLIC_SITE_URL=https://www.acertainwoman.org

# Email, sent over SMTP. The contact and newsletter routes answer 503 without
# SMTP_USER, SMTP_PASS and CONTACT_TO_EMAIL.
# SMTP_USER and SMTP_PASS sign in to the mailbox.
SMTP_USER=mailbox@your-domain.example
SMTP_PASS=your-mailbox-password
# Where the team receives the form submissions.
CONTACT_TO_EMAIL=inbox@your-domain.example

# Optional. The sender readers see. The address must be the mailbox or one of
# its aliases. Defaults to SMTP_USER and "A Certain Woman".
# SMTP_FROM=hello@your-domain.example
# SMTP_FROM_NAME=A Certain Woman
# Optional. The sender name on the alerts to the team, so they stand out in the
# inbox. Same address as SMTP_FROM. Defaults to "ACW Website".
# SMTP_ALERT_FROM_NAME=ACW Website

# Optional. Defaults are Hostinger's. Port 465 uses implicit TLS, 587 STARTTLS.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465

# BecomingHER applications (/contact?reason=becoming-her). Each application
# goes to KoboToolbox (KOBO_API_TOKEN) and the team gets a short email notice
# (the SMTP variables above). The route answers 503 when neither is set.
# API token of the Kobo account that owns the form (Account settings > Security).
KOBO_API_TOKEN=your-kobo-api-token
# Optional. OpenRosa submission endpoint; the default is the global server.
# KOBO_SUBMISSION_URL=https://kc.kobotoolbox.org/submission
# Optional. Who receives the email notice. Defaults to the public info address.
BECOMING_HER_TO_EMAIL=info@acertainwoman.org
# Optional. Copied on each notice. Defaults to the public info address, and is
# dropped when it is the same inbox as BECOMING_HER_TO_EMAIL.
# BECOMING_HER_CC_EMAIL=info@your-domain.example
# Optional. "open" or "closed" overrides the dates. Leave unset in production.
# Vercel preview deployments are open in test mode automatically for now (see
# PREVIEW_TEST_MODE in src/lib/data/becoming-her.ts).
# BECOMING_HER_APPLICATIONS=open
# Optional, local only. "1" validates applications but sends nothing to Kobo
# or email. Ignored in production builds.
# BECOMING_HER_DRY_RUN=1
